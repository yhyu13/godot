type Bullet @extends Area2D
    signals: hit
    state:
        damage: int = 2
    rule OnHit by Bullet target Player:
        when self.damage >= 2
        then target.hp -= 2, emit(hit)

type Player @extends CharacterBody2D
    state:
        hp: int = 10
        alive: bool = true
    rule Respawn by Player:
        when self.hp == 0
        then self.hp = 10
    rule Regenerate by Player:
        when self.hp <= 5
        then self.hp += 1
